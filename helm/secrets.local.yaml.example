# Copy to `secrets.local.yaml` in the REPO ROOT (that filename is gitignored)
# and fill in real values. Never commit the copy.
#
#   helm upgrade --install iep ./helm/iep -n iep --create-namespace \
#     -f helm/iep/values-dev.yaml -f secrets.local.yaml
#
# Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# This file is for LOCAL DEVELOPMENT ONLY. Staging and production use
# secrets.create=false + a SealedSecret — see helm/README.md §5.

secrets:
  create: true

  jwtSecretKey: "REPLACE_ME"
  mysqlRootPassword: "REPLACE_ME"

  # Must contain the same password as mysqlRootPassword above — this is the
  # connection string auth's SQLAlchemy actually uses, and the mysql container
  # is initialised from mysqlRootPassword. If they disagree, auth cannot connect.
  sqlDatabaseUrl: "mysql+pymysql://root:REPLACE_ME@mysql:3306/iep_auth?charset=utf8mb4"

  # Seeded into the users table on auth's first boot.
  directorEmail: "director@example.com"
  directorForename: "Scrooge"
  directorSurname: "McDuck"
  directorPassword: "REPLACE_ME"
