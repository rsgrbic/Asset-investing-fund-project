  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Vote outcomes",
      "description": "How votes ended. `timeout` means the deadline passed with no Finalized event -- the JOURNEY.md 11.1 race actually firing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(iep_voting_outcome_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Vote watcher threads in flight",
      "description": "One thread per in-flight vote, all in ONE gunicorn worker. This is why director is pinned to replicaCount: 1.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "iep_voting_threads_active",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Vote duration",
      "description": "Blockchain round trip, deploy to Finalized. Separate from HTTP latency: /decision returns 200 immediately.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iep_voting_duration_seconds_bucket[30m])))",
          "legendFormat": "p95",
          "refId": "A",
          "range": true
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(iep_voting_duration_seconds_bucket[30m])))",
          "legendFormat": "p50",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pending orders: app view vs Redis view",
      "description": "director counts the pending_order:* prefix. The exporter counts every key in db0. A gap means something else writes to Redis.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
