          "expr": "redis_db_keys{db=\"db0\"}",
          "legendFormat": "redis_db_keys (exporter)",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database calls per second",
      "description": "Attribution: which service drives which backend. Exporters cannot answer this -- the connection looks the same from the server side.",
