{
  "uid": "iep-redis-sdk",
  "title": "IEP - Redis",
  "tags": [
    "iep"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "instant": false,
          "legendFormat": "used",
          "range": true
        },
        {
          "expr": "redis_memory_max_bytes",
          "instant": false,
          "legendFormat": "maxmemory",
          "range": true
        }
      ],
      "title": "Memory used against the cap",
      "description": "used_memory is the allocator's accounting, not process RSS. maxmemory is enforced against THIS number, so this is the pair that decides when writes start failing.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_memory_used_bytes / redis_memory_max_bytes",
          "instant": false,
          "legendFormat": "used / maxmemory",
          "range": true
        }
      ],
      "title": "Memory as a fraction of the cap",
      "description": "The IepRedisMemoryHigh alert fires above 0.8. Policy is noeviction, so at 1.0 writes are refused with an error rather than keys being dropped.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_db_keys",
          "instant": false,
          "legendFormat": "{{db}}",
          "range": true
        }
      ],
      "title": "Keys per database",
      "description": "Redis has 16 databases by default; only db0 is used here. db0 should track iep_pending_orders on the application dashboard.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(redis_evicted_keys_total[5m])",
          "instant": false,
          "legendFormat": "evicted/s",
          "range": true
        },
        {
          "expr": "rate(redis_expired_keys_total[5m])",
          "instant": false,
          "legendFormat": "expired/s",
          "range": true
        }
      ],
      "title": "Evicted and expired keys",
      "description": "Evicted MUST stay flat at zero. maxmemory-policy is noeviction, so any eviction at all means the policy is not what this chart thinks it is -- and a dropped key is a lost order.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (cmd) (rate(redis_commands_total[5m]))",
          "instant": false,
          "legendFormat": "{{cmd}}",
          "range": true
        }
      ],
      "title": "Commands per second",
      "description": "By command name. Includes the exporter's own INFO and director's scrape-time SCAN, so this never reaches zero.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(redis_commands_duration_seconds_total[5m]) / rate(redis_commands_total[5m])",
          "instant": false,
          "legendFormat": "{{cmd}}",
          "range": true
        }
      ],
      "title": "Command latency, server side",
      "description": "Total command time divided by command count. Compare against iep_db_operation_duration_seconds on the application dashboard: the gap is network and client library time.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_connected_clients",
          "instant": false,
          "legendFormat": "connected",
          "range": true
        },
        {
          "expr": "redis_blocked_clients",
          "instant": false,
          "legendFormat": "blocked",
          "range": true
        }
      ],
      "title": "Clients",
      "description": "blocked_clients above zero means someone is using a blocking command such as BLPOP. This codebase uses none, so it should stay flat.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(redis_net_input_bytes_total[5m])",
          "instant": false,
          "legendFormat": "in",
          "range": true
        },
        {
          "expr": "rate(redis_net_output_bytes_total[5m])",
          "instant": false,
          "legendFormat": "out",
          "range": true
        }
      ],
      "title": "Network throughput",
      "description": "Useful mainly as a sanity check that traffic matches the command rate above.",
      "transparent": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {},
  "annotations": {}
}
